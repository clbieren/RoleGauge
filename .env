# =================================================================
# RoleGauge — Environment Variables Configuration (.env)
# =================================================================

APP_NAME=RoleGauge
APP_VERSION=0.1.0
DEBUG=false
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Database (SQLite default for local development, PostgreSQL for Docker/Production) ---
POSTGRES_USER=rolegauge
POSTGRES_PASSWORD=rolegauge
POSTGRES_DB=rolegauge
POSTGRES_PORT=5432
DATABASE_URL=sqlite+aiosqlite:///./rolegauge.db
# Docker PostgreSQL: DATABASE_URL=postgresql+asyncpg://rolegauge:rolegauge@db:5432/rolegauge

# --- GitHub API ---
GITHUB_TOKEN=
GITHUB_MAX_REPOS=100
GITHUB_MAX_FILE_SIZE=500000

# --- AI Provider ---
AI_PROVIDER=groq
GROQ_API_KEY=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
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Knowledge Base (Defaults to ./knowledge-base on local machine) ---
# In Docker: KB_PATH=/app/knowledge-base

# --- CORS Origins ---
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
