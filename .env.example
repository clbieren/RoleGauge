# =================================================================
# RoleGauge — Environment Variables Configuration
# =================================================================
# Copy this file to .env and fill in your values.
#
# Production Database: PostgreSQL is REQUIRED for production deployments.
# SQLite is reserved exclusively for local development and unit tests.
# =================================================================

# --- Application ---
APP_NAME=RoleGauge
APP_VERSION=0.1.0
DEBUG=false
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Database (PostgreSQL) ---
POSTGRES_USER=rolegauge
POSTGRES_PASSWORD=rolegauge
POSTGRES_DB=rolegauge
POSTGRES_PORT=5432
# In Docker, backend connects to the 'db' service:
DATABASE_URL=postgresql+asyncpg://rolegauge:rolegauge@db:5432/rolegauge

# --- GitHub API ---
# Optional Personal Access Token (Increases rate limit from 60 to 5,000 requests/hour)
GITHUB_TOKEN=
GITHUB_MAX_REPOS=100
GITHUB_MAX_FILE_SIZE=500000

# --- AI Provider ---
# "none" (Fast keyword-only mode) | "openai" | "gemini"
AI_PROVIDER=none

# OpenAI Configuration (when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini Configuration (when AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Knowledge Base ---
KB_PATH=/app/knowledge-base

# --- CORS Origins ---
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
