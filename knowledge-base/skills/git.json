        "git tag",
        "semantic versioning",
        "semver",
        "release",
        "annotated tag",
        "lightweight tag"
      ]
    },
    {
      "id": "git_hooks_automation",
      "name": "Git Hooks & Automation",
      "description": "Pre-commit hooks, CI triggers, and automated quality gates.",
      "keywords": [
        "pre-commit",
        "husky",
        "lint-staged",
        "git hooks",
        "pre-push",
        "commit-msg"
      ]
    }
  ],
  "evidence": {
    "github": [
      {
        "signal": "Multiple branches in repository",
