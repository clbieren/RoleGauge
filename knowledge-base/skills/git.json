  "subskills": [
    {
      "id": "basic_operations",
      "name": "Basic Git Operations",
      "description": "Init, clone, add, commit, push, pull, and status checking.",
      "keywords": [
        "git init",
        "git clone",
        "git add",
        "git commit",
        "git push",
        "git pull",
        "git status",
        "git log"
      ]
    },
    {
      "id": "branching_merging",
      "name": "Branching & Merging",
      "description": "Creating branches, merging strategies, resolving conflicts, and rebasing.",
      "keywords": [
        "git branch",
        "git checkout",
        "git merge",
        "git rebase",
        "conflict",
        "fast-forward",
        "squash"
      ]
    },
    {
      "id": "collaboration_workflows",
      "name": "Collaboration Workflows",
      "description": "Pull requests, code reviews, Gitflow, trunk-based development, and forking.",
      "keywords": [
        "pull request",
        "merge request",
        "code review",
        "gitflow",
        "trunk-based",
        "feature branch",
        "fork"
      ]
    },
    {
      "id": "gitignore_config",
