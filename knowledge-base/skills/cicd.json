        "strength": 0.7,
        "maps_to": [
          "cicd.pipeline_as_code",
          "cicd.jenkins"
        ]
      },
      {
        "signal": "GitLab CI configuration file present",
        "detection": "file_presence",
        "pattern": ".gitlab-ci.yml",
        "strength": 0.7,
