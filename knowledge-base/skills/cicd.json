{
  "skill_id": "cicd",
  "name": "CI/CD Pipelines",
  "category": "automation",
  "description": "Continuous Integration and Continuous Deployment/Delivery pipelines including pipeline-as-code, build/test/deploy stages, artifact management, and deployment strategies.",
  "subskills": [
    {
      "id": "pipeline_as_code",
      "name": "Pipeline-as-Code",
      "description": "Defining pipelines in version-controlled configuration files (YAML, Groovy/Jenkinsfile).",
