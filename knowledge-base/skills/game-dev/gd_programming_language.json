{
  "skill_id": "gd_programming_language",
  "name": "Game Programming Languages",
  "category": "programming",
  "description": "Proficiency in programming languages used in game development including C#, C++, GDScript, and Blueprints. Covers core syntax, OOP patterns, data structures, memory management, multithreading, serialization, and advanced architecture patterns like ECS.",
  "subskills": [
    {
      "id": "core_syntax",
      "name": "Core Language Syntax",
      "description": "Variables, control flow, functions, classes, and language-specific idioms in C#, C++, GDScript, or Blueprints.",
      "keywords": [
        "class",
        "function",
        "variable",
        "if",
        "for",
        "while",
        "switch",
        "enum",
        "struct",
        "MonoBehaviour",
        "AActor",
        "Node",
        "extends",
        "UCLASS",
        "UPROPERTY"
      ]
    },
    {
      "id": "oop_patterns",
      "name": "OOP & Design Patterns",
      "description": "Object-oriented programming principles and game-specific design patterns: Singleton, Observer, State, Command, Object Pool, Component pattern.",
      "keywords": [
        "inheritance",
        "polymorphism",
        "interface",
        "abstract",
        "singleton",
        "observer",
        "state pattern",
        "command pattern",
        "object pool",
        "component pattern",
        "factory",
        "strategy"
      ]
    },
    {
      "id": "data_structures",
      "name": "Data Structures & Collections",
      "description": "Using arrays, lists, dictionaries, queues, stacks, hash sets, and game-specific data containers (TArray, TMap, Godot arrays).",
      "keywords": [
        "List",
        "Dictionary",
        "Array",
        "Queue",
        "Stack",
        "HashSet",
        "TArray",
        "TMap",
        "TSet",
        "PackedArray",
        "sorted array",
        "priority queue"
      ]
    },
    {
      "id": "event_systems",
      "name": "Event Systems & Delegates",
      "description": "Implementing communication between game systems using events, delegates, signals, C# Actions/Events, Unreal delegates, and Godot signals.",
      "keywords": [
        "delegate",
        "event",
        "Action",
        "UnityEvent",
        "signal",
        "DECLARE_DYNAMIC_MULTICAST_DELEGATE",
        "EventHandler",
        "callback",
        "emit_signal",
        "connect",
        "multicast delegate"
      ]
    },
    {
      "id": "memory_management",
      "name": "Memory Management & Optimization",
      "description": "Understanding garbage collection, manual memory management, object pooling, reducing allocations, profiler usage, and heap/stack considerations.",
      "keywords": [
        "garbage collection",
        "GC",
        "object pooling",
        "allocation",
        "heap",
        "stack",
        "profiler",
        "memory leak",
        "Dispose",
        "IDisposable",
        "shared_ptr",
        "unique_ptr",
        "weak_ptr",
        "UPROPERTY GC"
      ]
    },
    {
      "id": "multithreading",
      "name": "Multithreading & Async",
      "description": "Thread-safe programming, async/await patterns, coroutines, Job System (Unity), Task Graph (Unreal), and thread synchronization.",
      "keywords": [
        "async",
        "await",
        "coroutine",
        "StartCoroutine",
        "UniTask",
        "Job System",
        "Burst",
        "Task Graph",
        "FRunnable",
        "thread",
        "mutex",
        "lock",
        "Thread.callv"
      ]
    },
    {
      "id": "serialization",
      "name": "Serialization & Data Persistence",
      "description": "Saving and loading game state, JSON/binary serialization, ScriptableObjects, DataAssets, Godot Resources, and save system architecture.",
      "keywords": [
        "JsonUtility",
        "JsonConvert",
        "BinaryFormatter",
        "ScriptableObject",
        "DataAsset",
        "Resource",
        "save game",
        "PlayerPrefs",
        "USaveGame",
        "ConfigFile",
        "protobuf",
        "serialization"
      ]
    },
    {
      "id": "native_plugin_dev",
      "name": "Native Plugin Development",
      "description": "Writing native C/C++ plugins for managed engines, P/Invoke, JNI bridges, GDExtension/GDNative, and platform-specific native code.",
      "keywords": [
        "DllImport",
        "P/Invoke",
        "native plugin",
        "JNI",
        "GDExtension",
        "GDNative",
        "extern",
        "marshalling",
        "unmanaged code",
        "cdecl",
        "stdcall"
      ]
    },
    {
      "id": "ecs_architecture",
      "name": "ECS Architecture",
      "description": "Entity Component System architecture: DOTS (Unity), Flecs, custom ECS frameworks, data-oriented design, archetype-based storage, and system scheduling.",
      "keywords": [
        "ECS",
        "Entity",
        "Component",
        "System",
        "DOTS",
        "data-oriented",
        "archetype",
        "IComponentData",
        "SystemBase",
        "IJobEntity",
        "Flecs",
        "EnTT"
      ]
    },
    {
      "id": "code_generation",
      "name": "Code Generation & Metaprogramming",
      "description": "Source generators, C++ templates and SFINAE, reflection systems, Unreal Header Tool (UHT), compile-time code generation, and annotation processing.",
      "keywords": [
        "source generator",
        "Roslyn",
        "T4 template",
        "UHT",
        "GENERATED_BODY",
        "reflection",
        "template metaprogramming",
        "SFINAE",
        "constexpr",
        "macro",
        "attribute"
      ]
    },
    {
      "id": "custom_allocators",
      "name": "Custom Memory Allocators",
      "description": "Implementing custom allocators: linear/arena allocators, pool allocators, stack allocators, TLSF, and engine-level memory management strategies.",
      "keywords": [
        "custom allocator",
        "arena allocator",
        "pool allocator",
        "stack allocator",
        "TLSF",
        "FMallocBinned",
        "FMemory",
        "placement new",
        "memory arena",
        "slab allocator"
      ]
    }
  ],
