{
  "skill_id": "gd_graphics_programming",
  "name": "Shader & Graphics Programming",
  "category": "graphics",
  "description": "Graphics programming skills including shader authoring (HLSL, GLSL, ShaderLab), material systems, lighting models, post-processing effects, compute shaders, render targets, custom render pipelines, GPU optimization, and ray tracing.",
  "subskills": [
    {
      "id": "shader_basics",
      "name": "Shader Fundamentals",
      "description": "Understanding the GPU rendering pipeline stages, shader types, and basic shader concepts (uniforms, varyings, samplers).",
      "keywords": [
        "shader",
        "vertex shader",
        "fragment shader",
        "pixel shader",
        "uniform",
