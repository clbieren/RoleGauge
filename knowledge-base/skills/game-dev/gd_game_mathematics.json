        "spatial index"
      ]
    },
    {
      "id": "numerical_methods",
      "name": "Numerical Methods & Simulation",
      "description": "Euler integration, Verlet integration, Runge-Kutta methods, fixed timestep simulation, numerical stability, and constraint solvers.",
