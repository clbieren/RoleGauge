        "NavMeshAgent",
        "pathfinding"
      ]
    },
    {
      "id": "procedural_generation",
      "name": "Procedural Generation Math",
      "description": "Noise functions (Perlin, Simplex), wave function collapse, L-systems, Voronoi diagrams, and procedural mesh generation algorithms.",
      "keywords": [
        "Perlin noise",
        "Simplex noise",
        "noise",
        "wave function collapse",
        "WFC",
        "L-system",
        "Voronoi",
        "Delaunay",
        "procedural mesh",
        "heightmap",
        "fractal",
        "octave"
      ]
    },
    {
      "id": "spatial_partitioning",
      "name": "Spatial Partitioning Structures",
      "description": "Quadtree, octree, BSP trees, k-d trees, bounding volume hierarchies (BVH), and spatial hashing for efficient queries.",
      "keywords": [
        "quadtree",
        "octree",
