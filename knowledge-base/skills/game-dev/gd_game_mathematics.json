        "catmull-rom",
        "cubic interpolation",
        "MoveTowards"
      ]
    },
    {
      "id": "collision_math",
      "name": "Collision Detection Math",
      "description": "AABB, sphere-sphere, ray-plane intersections, separating axis theorem (SAT), GJK algorithm, and broad/narrow phase collision.",
      "keywords": [
        "AABB",
        "bounding box",
        "sphere collision",
        "ray intersection",
        "SAT",
        "separating axis",
        "GJK",
        "broad phase",
        "narrow phase",
        "overlap",
        "intersection test"
      ]
    },
    {
      "id": "pathfinding_algorithms",
      "name": "Pathfinding Algorithms",
      "description": "A* algorithm, Dijkstra, navigation meshes, flow fields, hierarchical pathfinding, and navigation graph construction.",
