{
  "skill_id": "gd_game_mathematics",
  "name": "Game Mathematics",
  "category": "mathematics",
  "description": "Mathematical foundations for game development including vector operations, coordinate systems, trigonometry, matrix transformations, quaternions, interpolation, collision detection, pathfinding algorithms, procedural generation, and spatial data structures.",
  "subskills": [
    {
      "id": "vectors_basic",
      "name": "Vector Operations",
      "description": "Vector addition, subtraction, scaling, dot product, cross product, normalization, magnitude, and direction calculations.",
      "keywords": [
        "Vector2",
        "Vector3",
        "Vector4",
        "dot product",
        "cross product",
        "normalize",
        "magnitude",
        "direction",
        "FVector",
        "distance"
      ]
    },
    {
      "id": "coordinate_systems",
      "name": "Coordinate Systems & Transforms",
      "description": "World/local/screen space conversions, transform hierarchies, parent-child relationships, and coordinate system handedness.",
      "keywords": [
        "world space",
        "local space",
        "screen space",
        "Transform",
        "transform",
        "InverseTransformPoint",
        "TransformDirection",
        "to_local",
        "to_global",
        "coordinate system",
        "left-handed",
        "right-handed"
      ]
    },
    {
      "id": "trigonometry",
      "name": "Trigonometry for Games",
      "description": "Sine, cosine, tangent for rotations, circular motion, angle calculations, atan2, and arc-based movement.",
      "keywords": [
        "sin",
        "cos",
        "tan",
        "atan2",
        "Mathf.Sin",
        "Mathf.Cos",
        "radians",
        "degrees",
        "angle",
        "Deg2Rad",
        "circular motion"
      ]
    },
    {
      "id": "matrix_transforms",
      "name": "Matrix Transformations",
      "description": "Transformation matrices (translation, rotation, scale), matrix multiplication, model-view-projection pipeline, and homogeneous coordinates.",
      "keywords": [
        "Matrix4x4",
        "FMatrix",
        "TRS",
        "model matrix",
        "view matrix",
        "projection matrix",
        "MVP",
        "homogeneous",
        "affine transform",
        "basis",
        "Transform3D"
      ]
    },
    {
      "id": "quaternion_rotations",
      "name": "Quaternion Rotations",
      "description": "Quaternion representation of rotations, slerp, euler-to-quaternion conversion, gimbal lock avoidance, and quaternion multiplication.",
      "keywords": [
        "Quaternion",
        "Quat",
        "FQuat",
        "Slerp",
        "Euler",
