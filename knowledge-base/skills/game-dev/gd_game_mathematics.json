        "RotateTowards"
      ]
    },
    {
      "id": "interpolation",
      "name": "Interpolation & Curves",
      "description": "Linear interpolation (lerp), smoothstep, easing functions, Bezier curves, splines, and animation curve evaluation.",
      "keywords": [
        "Lerp",
        "Slerp",
        "SmoothStep",
        "SmoothDamp",
        "easing",
        "Bezier",
        "spline",
        "AnimationCurve",
