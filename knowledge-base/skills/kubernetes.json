  "evidence": {
    "github": [
      {
        "signal": "Kubernetes YAML manifests present (kind: Deployment, Service, etc.)",
        "detection": "content_analysis",
        "pattern": "kind: (Deployment|Service|Pod|Ingress|ConfigMap|Secret|StatefulSet|DaemonSet)",
        "strength": 0.7,
        "maps_to": [
          "kubernetes.deployments_replicasets",
          "kubernetes.services",
          "kubernetes.pods",
          "kubernetes.ingress",
          "kubernetes.configmaps_secrets"
        ]
      },
      {
        "signal": "Helm chart structure (Chart.yaml, values.yaml, templates/)",
        "detection": "file_presence",
        "pattern": "Chart.yaml|values.yaml|templates/",
        "strength": 0.8,
        "maps_to": [
          "kubernetes.helm"
        ]
      },
      {
        "signal": "Kustomize configuration (kustomization.yaml)",
        "detection": "file_presence",
        "pattern": "kustomization.yaml|kustomization.yml",
        "strength": 0.7,
        "maps_to": [
          "kubernetes.deployments_replicasets"
        ]
      },
      {
        "signal": "RBAC definitions (Role, ClusterRole, ServiceAccount)",
        "detection": "content_analysis",
        "pattern": "kind: (Role|ClusterRole|RoleBinding|ClusterRoleBinding|ServiceAccount)",
        "strength": 0.8,
        "maps_to": [
          "kubernetes.rbac"
        ]
      },
      {
        "signal": "Resource requests and limits defined in manifests",
        "detection": "content_analysis",
        "pattern": "resources:\\s*(requests:|limits:)",
        "strength": 0.7,
        "maps_to": [
          "kubernetes.resource_management"
        ]
      },
      {
        "signal": "Health probes defined (liveness, readiness)",
