        "maps_to": [
          "kubernetes.ingress"
        ]
      },
      {
        "signal": "PersistentVolumeClaim or StorageClass definitions",
        "detection": "content_analysis",
        "pattern": "kind: (PersistentVolumeClaim|PersistentVolume|StorageClass)",
        "strength": 0.6,
        "maps_to": [
          "kubernetes.persistent_storage"
