        "maps_to": [
          "kubernetes.health_probes"
        ]
      },
      {
        "signal": "Ingress resource with TLS and routing rules",
        "detection": "content_analysis",
        "pattern": "kind: Ingress.*tls:|kind: Ingress.*rules:",
