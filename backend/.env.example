# RoleGauge Backend Environment Variables
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql+asyncpg://rolegauge:rolegauge@localhost:5432/rolegauge

# GitHub (optional — without token, rate limit is 60 req/hr)
GITHUB_TOKEN=

# AI Provider: "openai" | "groq" | "gemini" | "none"
AI_PROVIDER=none

# OpenAI (only if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq (only if AI_PROVIDER=groq)
# Free tier: 30 req/min, 1000 req/day, 100K tokens/day — see console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (only if AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Authentication & JWT
# IMPORTANT: Generate a cryptographically secure 32+ byte random secret in production via:
#   openssl rand -hex 32
#   OR python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=rolegauge-development-secret-key-change-in-production-32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting & Redis Storage
# In development, leave blank to use in-memory rate limiting ("memory://").
# In production, REDIS IS MANDATORY to ensure rate limits are shared across all worker processes/pods:
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# Debug mode
DEBUG=false
