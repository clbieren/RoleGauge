# RoleGauge Backend Environment Variables
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql+asyncpg://rolegauge:rolegauge@localhost:5432/rolegauge

# GitHub (optional — without token, rate limit is 60 req/hr)
GITHUB_TOKEN=

# AI Provider: "openai" | "gemini" | "none"
AI_PROVIDER=none

# OpenAI (only if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini (only if AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Debug mode
DEBUG=false
